{
  "name": "evolution-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-based evolution simulator: a deterministic agent simulation running on a fixed timestep inside a Web Worker, rendered with Canvas 2D.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/browser-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "playwright": "^1.63.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
